{"name":"Mongoose","short_name":"Mongoose","description":"Play Project Mongoose and other MOOs, built for screen readers.","start_url":"/","display":"standalone","background_color":"#0f0f14","theme_color":"#0f254c","lang":"en","scope":"/","id":"/","categories":["games","entertainment","social"],"icons":[{"src":"/android-chrome-192x192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"/android-chrome-512x512.png","sizes":"512x512","type":"image/png","purpose":"any"}],"shortcuts":[{"name":"Host a MOO server","short_name":"Host","url":"/?mode=host","description":"Start a MOO from a database file and let others join."},{"name":"Play a local MOO","short_name":"Local","url":"/?mode=local","description":"Run the built-in minimal database in a window of its own."}],"protocol_handlers":[{"protocol":"web+mongoose","url":"/?protocol=%s"}],"file_handlers":[{"action":"/?mode=host","accept":{"application/x-moo-database":[".db"]}}],"share_target":{"action":"/share-target","method":"POST","enctype":"multipart/form-data","params":{"title":"title","text":"text","url":"url","files":[{"name":"files","accept":["*/*"]}]}},"launch_handler":{"client_mode":"focus-existing"}}
